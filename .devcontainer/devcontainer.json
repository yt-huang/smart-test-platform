{
  "name": "Smart Test Platform",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/node:2": { "version": "22", "installYarnUsingApt": false },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "智测平台", "onAutoForward": "openBrowser", "protocol": "http" }
  },
  "postCreateCommand": "bash scripts/codespace-setup.sh",
  "postStartCommand": "bash scripts/codespace-start.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "dbaeumer.vscode-eslint"]
    }
  }
}
